    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "lint": "echo ok"
  },
  "dependencies": {
    "@modular-forms/qwik": "^0.21.0"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "autoprefixer": "^10.4.0",
    "ignore": "^7.0.5",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-tsconfig-paths": "^4.2.0"
  }
}
