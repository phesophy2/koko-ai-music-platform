# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info

# Database
DATABASE_URL=postgres://koko:koko_dev@localhost:5432/koko

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
