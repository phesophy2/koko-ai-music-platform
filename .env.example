# ============================================
# KOKO AI MUSIC PLATFORM — ENVIRONMENT VARIABLES
# ============================================

# ============================================
# APP CONFIGURATION
# ============================================
APP_NAME=KOKO AI Music Platform
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/koko
DATABASE_POOL_SIZE=10
DATABASE_MAX_CONNECTIONS=20

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# ============================================
# API KEYS (Get from providers)
# ============================================
# Suno AI API
SUNO_API_KEY=your-suno-api-key
SUNO_API_URL=https://api.suno.ai/v1

# MusicGen API
MUSICGEN_API_KEY=your-musicgen-api-key
MUSICGEN_API_URL=https://api.musicgen.com/v1

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# Stable Diffusion
STABILITY_API_KEY=your-stability-api-key

# Google Sheets
GOOGLE_SHEETS_API_KEY=your-google-sheets-api-key
GOOGLE_SHEETS_ID=your-google-sheet-id

# ============================================
# CLOUD STORAGE
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=koko-audio
AWS_S3_ENDPOINT=

# Cloudflare R2 (Alternative)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=koko-audio

# ============================================
# SECURITY
# ============================================
ENCRYPTION_KEY=your-32-byte-encryption-key
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.koko.ai

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_AI_PLANNER=true
ENABLE_MULTI_GENERATION=true
ENABLE_AUTO_REGENERATION=true
ENABLE_VIRAL_CONTENT=true
ENABLE_ANALYTICS=true
ENABLE_AUDIT_LOGS=true

# ============================================
# COST OPTIMIZATION
# ============================================
MAX_COST_PER_GENERATION=0.50
DEFAULT_CREDITS=50
CREDIT_COST_PER_GENERATION=2
